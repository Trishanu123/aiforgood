# Public Supabase (optional — app works in memory without these)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Without this key, bill extraction and explanations use labeled fallbacks.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional NREL PVWatts key. Without it, solar uses a latitude-based yield estimate.
PVWATTS_API_KEY=
